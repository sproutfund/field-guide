{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve Jekyll with Search",
            "dependsOn": ["Build Jekyll (Dev)", "Index Search (Pagefind)"],
            "dependsOrder": "sequence",
            "command": "bundle exec jekyll serve --config '_config.yml,_config_dev.yml' --host 0.0.0.0 --livereload --skip-initial-build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Build Jekyll (Dev)",
            "type": "shell",
            "command": "bundle exec jekyll build --config '_config.yml,_config_dev.yml'",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Index Search (Pagefind)",
            "type": "shell",
            "command": "npx pagefind --site _site",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Serve Jekyll (Dev)",
            "type": "shell",
            "command": "bundle exec jekyll serve --config '_config.yml,_config_dev.yml' --host 0.0.0.0 --livereload",
            "group": "build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Serve Jekyll (Dev + Incremental)",
            "type": "shell",
            "command": "bundle exec jekyll serve --config '_config.yml,_config_dev.yml' --host 0.0.0.0 --livereload --incremental",
            "group": "build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Build Jekyll (Production)",
            "type": "shell",
            "command": "bundle exec jekyll build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build Jekyll (Production) with Search",
            "type": "shell",
            "command": "bundle exec jekyll build && npx pagefind --site _site",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Export Field Guide to Markdown (Ruby Script)",
            "type": "shell",
            "command": "ruby export_fieldguide.rb",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Export Field Guide to Markdown (Jekyll)",
            "type": "shell",
            "command": "bundle exec jekyll build --config '_config.yml,_config_export.yml' && mkdir -p exports && cp _site/FIELDGUIDE_all.md _site/FIELDGUIDE_catalytic-funding.md _site/FIELDGUIDE_community-building.md exports/",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
